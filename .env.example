DATABASE_URL=postgresql://invoicelens:local-demo-only@127.0.0.1:54329/invoicelens_demo
APP_URL=http://127.0.0.1:3000
APP_ENV=demo
# Local mode requires a loopback URL and is rejected in production.
AUTH_MODE=local
# For deployment use AUTH_MODE=basic, HTTPS, and strong unique credentials:
WORKSPACE_USER=reviewer
WORKSPACE_PASSWORD=
STORAGE_DIR=.data/files
OCR_PROVIDER=tesseract
MAX_FILE_MB=10
MAX_PAGES=10
ROUNDING_TOLERANCE_MINOR=1
