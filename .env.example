# The browser-facing Next.js app. Use individual for hosted and pilot access.
APP_URL=http://127.0.0.1:3000
APP_ENV=demo
AUTH_MODE=local
# Generated by npm run services:db for local mode; configure a private identity DB for Compose.
AUTH_DATABASE_URL=
AUTH_SECRET=
WORKFLOW_IDENTITY_SECRET=
WORKSPACE_USER=reviewer
WORKSPACE_PASSWORD=
MAX_FILE_MB=10
