# Copy to .env.microservices and replace every value before starting Compose.
POSTGRES_ADMIN_PASSWORD=replace-with-unique-random-password
WORKFLOW_DB_PASSWORD=replace-with-a-unique-random-password
EXTRACTION_DB_PASSWORD=replace-with-a-unique-random-password
DECISION_DB_PASSWORD=replace-with-a-unique-random-password
IDENTITY_DB_PASSWORD=replace-with-a-unique-random-password
WORKFLOW_TOKEN=replace-with-a-different-at-least-32-random-bytes
WORKFLOW_IDENTITY_SECRET=replace-with-an-independent-32-byte-random-secret
EXTRACTION_TOKEN=replace-with-a-different-at-least-32-random-bytes
DECISION_TOKEN=replace-with-a-different-at-least-32-random-bytes
AUTH_SECRET=replace-with-an-independent-32-byte-random-auth-secret
APP_URL=http://127.0.0.1:3000
APP_PORT=3000
ROUNDING_TOLERANCE_MINOR=1
# Demo seed supplies synthetic vendors, POs, and one prior commitment.
# Use production and provision real references before a hosted deployment.
DECISION_APP_ENV=production
