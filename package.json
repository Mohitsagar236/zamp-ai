{
  "name": "invoicelens",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/services-dev.ts",
    "build": "next build",
    "db:migrate": "tsx scripts/migrate-services.ts",
    "migrate:legacy": "tsx scripts/migrate-legacy.ts",
    "db:seed": "tsx scripts/seed-decision.ts",
    "auth:migrate": "tsx scripts/auth-migrate.ts",
    "auth:bootstrap": "tsx scripts/auth-bootstrap.ts",
    "test": "vitest run",
    "pretest:e2e": "INVOICELENS_DIST_DIR=.next-tests npm run build",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check src scripts tests packages services",
    "services:db": "tsx scripts/services-local.ts",
    "services:test-db": "tsx scripts/services-local.ts --test",
    "services:workflow": "tsx scripts/start-service.ts workflow",
    "services:extraction": "tsx scripts/start-service.ts extraction",
    "services:decision": "tsx scripts/start-service.ts decision",
    "test:all": "npm test && npm run test:e2e",
    "evaluate:extraction": "tsx scripts/evaluate-extraction.ts",
    "evaluate:authorized": "tsx scripts/evaluate-authorized.ts",
    "backup:compose": "bash scripts/backup-compose.sh",
    "restore:compose": "bash scripts/restore-isolated-compose.sh",
    "verify:compose": "tsx scripts/verify-compose.ts",
    "compose:env": "bash scripts/prepare-compose-env.sh",
    "evaluate:public": "tsx scripts/evaluate-public.ts",
    "prepare:public": "python3 scripts/prepare-public-evaluation.py",
    "services:production-db": "tsx scripts/services-local.ts --production",
    "start:production-local": "tsx scripts/services-dev.ts --production",
    "build:services": "npm run build --prefix services/workflow && npm run build --prefix services/extraction && npm run build --prefix services/decision",
    "build:production-local": "INVOICELENS_DIST_DIR=.next-production npm run build && npm run build:services",
    "auth:recover-admin": "tsx scripts/auth-recover-admin.ts",
    "verify:provision": "tsx scripts/provision-validation.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.14",
    "dotenv": "18.0.9",
    "lucide-react": "1.65.0",
    "next": "16.4.3",
    "pdfjs-dist": "6.4.299",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "pdf-lib": "1.17.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.13.0 <23 || >=24"
  }
}
